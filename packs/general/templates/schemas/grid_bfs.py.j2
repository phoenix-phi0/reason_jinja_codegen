def solve({{ params|join(', ') }}):
    grid = {{ relations.one('grid', key) }}
    rows = len(grid)
    cols = len(grid[0]) if rows else 0
    steps = grid_shortest_path(grid, {{ walk|sort|pyrepr }}, {{ locate(s[1], s[2]) }}, {{ locate(t[1], t[2]) }}, {{ relations.one('neighbours', key) == '8' }})
    return {{ value(relations.one('no_answer', key)) }} if steps is None else steps
