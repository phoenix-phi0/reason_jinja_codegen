{#- One glue template for the element-pipeline schemas seq_fold, seq_rank, seq_reduce and palindrome_check (the other three schema files include this one): keep/drop/remainder/bound/digit-sum filters, map/floordiv/scale/add, distinct; only the final step differs. -#}
{%- set sch = relations.one('schema', key) -%}
{%- from 'composition.j2' import source_expr, tree_expr, intval with context -%}
{%- set COND = {
  'even': 'x % 2 == 0', 'odd': 'x % 2 != 0', 'positive': 'x > 0', 'negative': 'x < 0',
  'nonzero': 'x != 0', 'zero': 'x == 0',
  'vowel': "x in 'aeiouAEIOU'", 'consonant': "x.isascii() and x.isalpha() and x not in 'aeiouAEIOU'",
  'letter': 'x.isalpha()', 'ascii_letter': "x.isascii() and x.isalpha()", 'digit': 'x.isdigit()', 'upper': 'x.isupper()', 'lower': 'x.islower()',
  'space': 'x.isspace()', 'alnum': 'x.isalnum()'} -%}
{%- set CMP = {'ge': '>=', 'gt': '>', 'le': '<=', 'lt': '<', 'eq': '==', 'ne': '!='} -%}
{%- set MAP = {'identity': 'x', 'square': 'x * x', 'abs': 'abs(x)', 'negate': '-x', 'to_int': 'int(x)',
               'lower': 'x.lower()', 'upper': 'x.upper()'} -%}
{%- set conds = [] -%}
{%- for r in relations.rows('keep', key) %}{% set _ = conds.append(COND[r[-1]]) %}{% endfor -%}
{%- for r in relations.rows('drop', key) %}{% set _ = conds.append('not (' ~ COND[r[-1]] ~ ')') %}{% endfor -%}
{%- for r in relations.rows('remainder', key) %}{% set _ = conds.append('x % ' ~ (r[-2]|int) ~ ' == ' ~ (r[-1]|int)) %}{% endfor -%}
{%- for r in relations.rows('bound', key) %}{% set o = r[-2] %}{% set _ = conds.append(('abs(x) ' ~ CMP[o[4:]] if o.startswith('abs_') else 'x ' ~ CMP[o]) ~ ' ' ~ intval(key, r[-1])) %}{% endfor -%}
{%- set dtests = relations.rows('digit_sum_test', key) -%}
{%- for r in relations.rows('filter', key) %}{% set _ = conds.append('(' ~ tree_expr(key, r[-1], COND, CMP) ~ ')') %}{% endfor -%}
{%- set dbounds = relations.rows('digit_sum_bound', key) -%}
{%- for r in dtests %}{% set _ = conds.append('s % ' ~ (r[-2]|int) ~ ' == ' ~ (r[-1]|int)) %}{% endfor -%}
{%- for r in dbounds %}{% set _ = conds.append('s ' ~ CMP[r[-2]] ~ ' ' ~ (r[-1]|int)) %}{% endfor -%}
{%- set use_ds = (dtests|length > 0) or (dbounds|length > 0) -%}
{%- set maps = relations.rows('map', key) -%}
{%- set expr = [MAP[maps[0][-1] if maps else 'identity']] -%}
{%- for r in relations.rows('floordiv', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') // (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- for r in relations.rows('scale', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') * (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- for r in relations.rows('add', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') + (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- set aggs = relations.rows('aggregate', key) -%}
{%- set agg = aggs[0][-1] if aggs else none -%}
{%- set dist = relations.rows('distinct', key)|map('last')|list -%}
{%- set src = source_expr(key) -%}
{%- set iterable = ('dict.fromkeys(' ~ src ~ ')') if 'original' in dist else src -%}
{% if not inline|default(false) %}def {{ fname|default('solve') }}({{ (fparams|default(params))|join(', ') }}):{% endif %}
{% if use_ds %}
    items = list({{ iterable }})
    values = [{{ expr[-1] }} for x, s in zip(items, digit_sums(items)){% if conds %} if {{ conds|join(' and ') }}{% endif %}]
{% else %}
    values = [{{ expr[-1] }} for x in {{ iterable }}{% if conds %} if {{ conds|join(' and ') }}{% endif %}]
{% endif %}
{% if 'mapped' in dist %}
    values = list(dict.fromkeys(values))
{% endif %}
{% if sch == 'seq_rank' %}
{% set rk = relations.rows('select_rank', key)[0] %}
{% set kv = rk[2] %}
{% set e = relations.one('if_empty', key) %}
    chosen = kth_value(values, {{ kv if relations.has('arg', key, kv, 'int') else (kv|int) }}, {{ rk[1]|pyrepr }})
    return {{ 'None' if e == 'none' else (e|int) }} if chosen is None else chosen
{% elif sch == 'seq_reduce' %}
{% set e = relations.one('if_empty', key) %}
    result = fold_integers(values, {{ relations.rows('fold', key)[0][-1]|pyrepr }})
    return {{ 'None' if e == 'none' else (e|int) }} if result is None else result
{% elif sch == 'palindrome_check' %}
{% set outs = relations.rows('palindrome_output', key) %}
{% set tols = relations.rows('palindrome_tolerance', key) %}
{% set tv = tols[0][1] if tols else '0' %}
    return sequence_palindrome(values, {{ (outs[0][-1] if outs else 'check')|pyrepr }}, {{ tv if relations.has('arg', key, tv, 'int') else (tv|int) }})
{% elif agg in ('max', 'min') %}
    {{ ret|default('return') }} {{ agg }}(values) if values else {{ value(relations.one('if_empty', key)) }}
{% elif agg == 'sum' %}
{% if relations.rows('if_empty', key) %}
    {{ ret|default('return') }} sum(values) if values else {{ value(relations.one('if_empty', key)) }}
{% else %}
    {{ ret|default('return') }} sum(values)
{% endif %}
{% elif agg == 'count' %}
    {{ ret|default('return') }} len(values)
{% elif agg == 'product' %}
    result = 1
    for v in values:
        result *= v
    {{ ret|default('return') }} result
{% elif agg == 'list' %}
    {{ ret|default('return') }} values
{% elif agg == 'join' %}
    {{ ret|default('return') }} ''.join(values)
{% elif agg == 'distinct_count' %}
    {{ ret|default('return') }} len(set(values))
{% elif agg == 'is_palindrome' %}
    {{ ret|default('return') }} sequence_palindrome(values, 'check', 0)
{% endif %}
