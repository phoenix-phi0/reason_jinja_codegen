{%- set params = item.params -%}
{%- macro value(v) -%}{{ 'None' if v == 'none' else (v|int) }}{%- endmacro -%}
{%- from 'composition.j2' import source_expr, tree_expr, intval with context -%}
{%- set COND = {
  'even': 'x % 2 == 0', 'odd': 'x % 2 != 0', 'positive': 'x > 0', 'negative': 'x < 0',
  'nonzero': 'x != 0', 'zero': 'x == 0',
  'vowel': "x in 'aeiouAEIOU'", 'consonant': "x.isascii() and x.isalpha() and x not in 'aeiouAEIOU'",
  'letter': 'x.isalpha()', 'ascii_letter': "x.isascii() and x.isalpha()", 'digit': 'x.isdigit()', 'upper': 'x.isupper()', 'lower': 'x.islower()',
  'space': 'x.isspace()', 'alnum': 'x.isalnum()'} -%}
{%- set CMP = {'ge': '>=', 'gt': '>', 'le': '<=', 'lt': '<', 'eq': '==', 'ne': '!='} -%}
{%- set MAP = {'identity': 'x', 'square': 'x * x', 'abs': 'abs(x)', 'negate': '-x', 'to_int': 'int(x)',
               'lower': 'x.lower()', 'upper': 'x.upper()'} -%}
{%- set conds = [] -%}
{%- for r in relations.rows('keep', key) %}{% set _ = conds.append(COND[r[-1]]) %}{% endfor -%}
{%- for r in relations.rows('drop', key) %}{% set _ = conds.append('not (' ~ COND[r[-1]] ~ ')') %}{% endfor -%}
{%- for r in relations.rows('remainder', key) %}{% set _ = conds.append('x % ' ~ (r[-2]|int) ~ ' == ' ~ (r[-1]|int)) %}{% endfor -%}
{%- for r in relations.rows('bound', key) %}{% set op = r[-2] %}{% set lhs = 'abs(x)' if op.startswith('abs_') else 'x' %}{% set cmpop = op[4:] if op.startswith('abs_') else op %}{% set _ = conds.append(lhs ~ ' ' ~ CMP[cmpop] ~ ' ' ~ intval(key, r[-1])) %}{% endfor -%}
{%- set dtests = relations.rows('digit_sum_test', key) -%}
{%- for r in relations.rows('filter', key) %}{% set _ = conds.append('(' ~ tree_expr(key, r[-1], COND, CMP) ~ ')') %}{% endfor -%}
{%- set dbounds = relations.rows('digit_sum_bound', key) -%}
{%- for r in dtests %}{% set _ = conds.append('s % ' ~ (r[-2]|int) ~ ' == ' ~ (r[-1]|int)) %}{% endfor -%}
{%- for r in dbounds %}{% set _ = conds.append('s ' ~ CMP[r[-2]] ~ ' ' ~ (r[-1]|int)) %}{% endfor -%}
{%- set use_ds = (dtests|length > 0) or (dbounds|length > 0) -%}
{%- set expr = [MAP[relations.one('map_fn', key)]] -%}
{%- for r in relations.rows('floordiv', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') // (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- for r in relations.rows('scale', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') * (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- for r in relations.rows('add', key) %}{% set _ = expr.append('(' ~ expr[-1] ~ ') + (' ~ (r[-1]|int) ~ ')') %}{% endfor -%}
{%- set agg = relations.one('aggregate', key) -%}
{%- set dist = relations.rows('distinct', key)|map('last')|list -%}
{%- set src = source_expr(key) -%}
def {{ fname|default('solve') }}({{ (fparams|default(params))|join(', ') }}):
    items = []
    for x in {{ src }}:
{% if 'original' in dist %}
        if x in items:
            continue
{% endif %}
        items.append(x)
    values = []
    for x in items:
{% if use_ds %}
        s = sum(int(c) for c in str(abs(x)))
{% endif %}
{% if conds %}
        if not ({{ conds|join(' and ') }}):
            continue
{% endif %}
        values.append({{ expr[-1] }})
{% if 'mapped' in dist %}
    unique = []
    for v in values:
        if v not in unique:
            unique.append(v)
    values = unique
{% endif %}
{% if agg in ('max', 'min') %}
    if not values:
        return {{ value(relations.one('if_empty', key)) }}
    best = values[0]
    for v in values[1:]:
        if v {{ '>' if agg == 'max' else '<' }} best:
            best = v
    return best
{% elif agg == 'sum' %}
{% if relations.rows('if_empty', key) %}
    if not values:
        return {{ value(relations.one('if_empty', key)) }}
{% endif %}
    total = 0
    for v in values:
        total += v
    return total
{% elif agg == 'count' %}
    n = 0
    for v in values:
        n += 1
    return n
{% elif agg == 'product' %}
    result = 1
    for v in values:
        result *= v
    return result
{% elif agg == 'list' %}
    return list(values)
{% elif agg == 'join' %}
    out = ''
    for v in values:
        out += v
    return out
{% elif agg == 'distinct_count' %}
    seen = []
    for v in values:
        if v not in seen:
            seen.append(v)
    return len(seen)
{% elif agg == 'is_palindrome' %}
    backwards = []
    for v in values:
        backwards.insert(0, v)
    return values == backwards
{% endif %}
