{%- from 'composition.j2' import source_expr with context -%}
{%- set d = 1 if relations.has('interval_ends', key, 'closed') else 0 -%}
{%- set gaps = relations.rows('interval_gap', key) -%}
{%- set reach = d + ((gaps[0][-1]|int) if gaps else 0) -%}
{%- set mind = relations.rows('min_depth', key) -%}
{%- set maxd = relations.rows('max_depth', key) -%}
{%- set outs = relations.rows('interval_output', key) -%}
{%- set form = outs[0][-1] if outs else 'intervals' -%}
{%- set pouts = relations.rows('pair_output', key) -%}
{%- set pform = pouts[0][-1] if pouts else 'count' -%}
{%- set thr = relations.rows('at_least', key) -%}
def {{ fname|default('solve') }}({{ (fparams|default(params))|join(', ') }}):
    pairs = [[iv[0], iv[1]] for iv in {{ source_expr(key) }} if iv[0] < iv[1] + {{ d }}]
    reach = {{ reach }}

    def depth(x):  # interval [s, e] covers the integer points s <= x < e + reach
        return sum(1 for s, e in pairs if s <= x < e + reach)

    points = range(min((s for s, _ in pairs), default=0), max((e + reach for _, e in pairs), default=0) + 1)
{% if relations.has('ask', key, 'overlap_pairs') %}
    total = good = 0
    for i in range(len(pairs)):
        for j in range(i + 1, len(pairs)):
            total += 1
            if max(pairs[i][0], pairs[j][0]) < min(pairs[i][1], pairs[j][1]) + reach:
                good += 1
    hits = {{ 'total - good' if relations.has('pair_relation', key, 'disjoint') else 'good' }}
{% if pform == 'exists' %}
    return hits > 0
{% elif pform == 'all' %}
    return hits == total
{% else %}
    return hits
{% endif %}
{% elif relations.has('ask', key, 'covered_length') %}
    lo, hi = {{ (mind[0][-1]|int) if mind else 1 }}, {{ (maxd[0][-1]|int) if maxd else None }}
    return sum(1 for x in points if depth(x) >= lo and (hi is None or depth(x) <= hi))
{% elif relations.has('ask', key, 'merge_intervals') %}
    group = list(range(len(pairs)))  # join every two intervals that touch, until stable

    def find(i):
        while group[i] != i:
            i = group[i]
        return i
    for i in range(len(pairs)):
        for j in range(len(pairs)):
            if i != j and max(pairs[i][0], pairs[j][0]) < min(pairs[i][1], pairs[j][1]) + reach:
                group[find(i)] = find(j)
    spans = {}
    for i, (s, e) in enumerate(pairs):
        g = find(i)
        lo_s, hi_e = spans.get(g, (s, e))
        spans[g] = (min(lo_s, s), max(hi_e, e))
    merged = sorted([list(v) for v in spans.values()])
{% if form == 'merged_count' %}
    return len(merged)
{% elif form == 'covered_count' %}
    return sum(e - s + {{ d }} for s, e in merged)
{% elif form == 'gap_count' %}
    return sum(merged[i + 1][0] - merged[i][1] - {{ d }} for i in range(len(merged) - 1))
{% elif form == 'longest_covered' %}
    return max((e - s + {{ d }} for s, e in merged), default=0)
{% else %}
    return merged
{% endif %}
{% else %}
    best = max((depth(x) for x in points), default=0)
{% if thr %}
    return best >= {{ thr[0][-1]|int }}
{% else %}
    return best
{% endif %}
{% endif %}
