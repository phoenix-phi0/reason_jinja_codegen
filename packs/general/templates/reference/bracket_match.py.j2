{%- from 'composition.j2' import source_expr with context -%}
{%- set params = item.params -%}
{%- set pairs = [] -%}
{%- for r in relations.rows('bracket_pair', key) %}{% set _ = pairs.append([r[1], r[2]]) %}{% endfor -%}
{%- set outs = relations.rows('bracket_output', key) -%}
{%- set form = outs[0][-1] if outs else 'balanced' -%}
def {{ fname|default('solve') }}({{ (fparams|default(params))|join(', ') }}):
    text = {{ source_expr(key) }}
    pairs = dict({{ pairs|sort|pyrepr }})
    closers = set(pairs.values())
    mode = {{ form|pyrepr }}

    def reduce(seq):
        seq = list(seq)
        changed = True
        while changed:
            changed = False
            for k in range(len(seq) - 1):
                if seq[k][1] in pairs and pairs[seq[k][1]] == seq[k + 1][1]:
                    del seq[k:k + 2]
                    changed = True
                    break
        return seq

    toks = [(i, t) for i, t in enumerate(text) if t in pairs or t in closers]
    full = reduce(toks)
    if mode == 'balanced':
        return not full
    if mode == 'max_depth':
        if full:
            return -1
        best = 0
        cur = 0
        for _, t in toks:
            cur += 1 if t in pairs else -1
            best = max(best, cur)
        return best
    for m in range(1, len(toks) + 1):
        if any(t in closers for _, t in reduce(toks[:m])):
            return toks[m - 1][0]
    if full:
        return full[-1][0]
    return -1
