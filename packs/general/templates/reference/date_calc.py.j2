{%- set params = params if params is defined else item.params -%}
{%- set f = relations.rows('date_fields', key)[0] -%}
{%- set o = relations.rows('date_origin', key) -%}
{%- set form = relations.one('date_form', key) -%}
{%- set org = [o[0][1]|int, o[0][2]|int, o[0][3]|int] if o else [1970, 1, 1] -%}
def solve({{ params|join(', ') }}):
    lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

    def leap(v):
        return v % 4 == 0 and (v % 100 != 0 or v % 400 == 0)

    def ordinal(yy, mm, dd):
        # day number with 0001-01-01 = 1; the calendar repeats every 400 years (146097 days)
        cycles, rest = divmod(yy - 1, 400)
        total = cycles * 146097
        for v in range(1, rest + 1):
            total += 366 if leap(v) else 365
        for mo in range(1, mm):
            total += lengths[mo - 1] + (1 if mo == 2 and leap(yy) else 0)
        return total + dd

    here = ordinal({{ f[1] }}, {{ f[2] }}, {{ f[3] }})
    origin = ordinal({{ org[0] }}, {{ org[1] }}, {{ org[2] }})
{% if form == 'abs_days' %}
    return abs(here - origin)
{% elif form == 'weekday' %}
    return (here - 1) % 7
{% elif form == 'day_of_year' %}
    return here - ordinal({{ f[1] }}, 1, 1) + 1
{% else %}
    return here - origin
{% endif %}
