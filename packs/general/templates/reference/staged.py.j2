{#- Reference for a chain of stages: every stage is its own slow reference function _stageI(params, _s1, ..., _s(I-1)); solve() calls them in order. -#}
{%- set pkey = key -%}
{%- set n = relations.rows('substage', pkey)|length -%}
{% for i in range(1, n + 1) %}
{%- set key = relations.one('substage', pkey, i|string) -%}
{%- set fname = '_stage' ~ i -%}
{%- set fps = [] -%}
{%- for j in range(1, i) %}{% set _ = fps.append('_s' ~ j) %}{% endfor -%}
{%- set fparams = params + fps %}
{% include 'reference/' ~ relations.one('schema', key) ~ '.py.j2' %}

{% endfor %}
def solve({{ params|join(', ') }}):
{% for i in range(1, n + 1) %}
{%- set args = [] -%}
{%- for p in params %}{% set _ = args.append(p) %}{% endfor -%}
{%- for j in range(1, i) %}{% set _ = args.append('_s' ~ j) %}{% endfor %}
    {{ 'return' if i == n else '_s' ~ i ~ ' =' }} _stage{{ i }}({{ args|join(', ') }})
{% endfor %}
