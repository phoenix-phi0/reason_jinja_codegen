% ---------- element facts on a schema that never reads them (they would be ignored silently: a stage chain was probably meant); bound and floordiv have their own rules in learned.dl
element_schema(seq_fold) :- .
element_schema(seq_rank) :- .
element_schema(seq_reduce) :- .
element_schema(palindrome_check) :- .
element_used(P) :- keep(P,C).
element_used(P) :- drop(P,C).
element_used(P) :- remainder(P,M,R).
element_used(P) :- map(P,F).
element_used(P) :- scale(P,N).
element_used(P) :- add(P,N).
element_used(P) :- distinct(P,S).
error(element_fact_ignored,P) :- schema(P,S), not element_schema(S), element_used(P).
