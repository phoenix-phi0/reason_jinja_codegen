{"id": "glm_shared_divisor", "signature": "solve(nums)", "statement": "Given a list of positive integers nums, return the greatest common divisor of all of them. Return 0 for an empty list. A single-element list returns that element.", "tests": [{"args": [[]], "expected": 0}, {"args": [[7]], "expected": 7}, {"args": [[12, 18]], "expected": 6}, {"args": [[5, 10, 15]], "expected": 5}, {"args": [[8, 12, 20]], "expected": 4}, {"args": [[13, 17]], "expected": 1}, {"args": [[100, 75, 50]], "expected": 25}, {"args": [[1, 2, 3]], "expected": 1}, {"args": [[6, 6, 6]], "expected": 6}, {"args": [[9, 27, 81, 243]], "expected": 9}, {"args": [[48, 180, 120]], "expected": 12}], "facts": [["arg", "nums", "int_list"], ["iterate", "nums"], ["fold", "gcd"], ["if_empty", "0"], ["size", "nums", "tiny"]], "deps": {"schema": ["seq_reduce"], "uses": ["fold_integers"], "solution_sha256": "c5aa8072210311aad49694c1dde8c622dc2579ab26f1a054fe9e610928e6962e", "reference_sha256": "82fc10454ac1c4673ddbe644f913da60903e846d0c95b10a16b5705c25a22933"}}