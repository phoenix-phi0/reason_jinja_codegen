{"id": "grid_s_to_e", "signature": "solve(board)", "statement": "board is a list of strings containing exactly one 'S', exactly one 'E', walls '#' and open cells '.'. Return the minimum number of 4-directional moves from S to E without entering walls, or -1 if E is unreachable.", "tests": [{"args": [[".SE.", "###.", "###.", ".#.."]], "expected": 1}, {"args": [[".....#.#", "##....##", "...#.#.#", "..#....#", ".....##E", "S#.##..#", "..#####.", "........", ".#...#..", "........"]], "expected": -1}, {"args": [[".###.#...", "##......#", "#..##..#.", "##..#...E", "...#...##", ".S....#.#", "......#.."]], "expected": 9}, {"args": [["SE#.", "#..#"]], "expected": 1}, {"args": [["##..E.#.##", "S.#.....##", "..#...#..#"]], "expected": -1}, {"args": [["#.E#.....", "#....#S##"]], "expected": 7}, {"args": [["....", "....", ".#S.", "#..#", ".#..", "....", "#E.#", "#...", "#...", ".##."]], "expected": 5}, {"args": [["SE"]], "expected": 1}, {"args": [["S#E"]], "expected": -1}, {"args": [["S.", "#E"]], "expected": 2}], "facts": [["arg", "board", "grid"], ["passable", "."], ["start", "char", "S"], ["goal", "char", "E"], ["ask", "shortest_path"], ["size", "board", "tiny"]], "deps": {"schema": ["grid_bfs"], "uses": ["grid_find", "grid_shortest_path"], "solution_sha256": "abbc7668f99c0233b4dce7cf77805199b3779c5b2d2190845d23a2e587fb183a", "reference_sha256": "8117497365c47c6ae8088b5ecf47a99ef33157c76b473d021596841538108368"}}