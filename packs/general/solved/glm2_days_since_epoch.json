{"id": "glm2_days_since_epoch", "signature": "solve(y, m, d)", "statement": "Given a valid calendar date as year y, month m and day d (y is an integer >= 1), return the number of days from 2000-01-01 to that date: positive if the date is after 2000-01-01, zero if equal, and negative if before (e.g. 1999-12-31 gives -1). Uses the proleptic Gregorian calendar.", "tests": [{"args": [2000, 1, 1], "expected": 0}, {"args": [2000, 1, 2], "expected": 1}, {"args": [1999, 12, 31], "expected": -1}, {"args": [2000, 3, 1], "expected": 60}, {"args": [1996, 2, 29], "expected": -1402}, {"args": [2024, 2, 29], "expected": 8825}, {"args": [1970, 1, 1], "expected": -10957}, {"args": [2001, 12, 25], "expected": 724}, {"args": [2000, 2, 29], "expected": 59}, {"args": [1999, 1, 1], "expected": -365}, {"args": [2004, 2, 29], "expected": 1520}, {"args": [2000, 12, 31], "expected": 365}], "facts": [["arg", "y", "int"], ["arg", "m", "int"], ["arg", "d", "int"], ["ask", "date_offset"], ["date_fields", "y", "m", "d"], ["date_origin", "2000", "1", "1"]], "deps": {"schema": ["date_calc"], "uses": ["date_offset"], "solution_sha256": "cc3bcf6aa142af800a44fae25e89c662d8029098855903fca7e1bb2c173796ae", "reference_sha256": "4607906dcf4f931601a0c99c43abe768927ec1af17a681136334ebad0f5a62d7"}}