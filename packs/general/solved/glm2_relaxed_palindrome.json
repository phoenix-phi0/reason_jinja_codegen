{"id": "glm2_relaxed_palindrome", "signature": "solve(s)", "statement": "Given a string s (possibly empty), return True if it reads the same forwards and backwards after keeping only its alphanumeric characters and lowercasing them, otherwise False. An empty string, or one with no alphanumeric characters at all, counts as True.", "tests": [{"args": [""], "expected": true}, {"args": ["a"], "expected": true}, {"args": ["ab"], "expected": false}, {"args": ["A man, a plan, a canal: Panama"], "expected": true}, {"args": ["race a car"], "expected": false}, {"args": ["!!"], "expected": true}, {"args": ["0P"], "expected": false}, {"args": ["No 'x' in Nixon"], "expected": true}, {"args": ["Able was I, ere I saw Elba"], "expected": true}, {"args": ["12321"], "expected": true}, {"args": ["Ab_1bA"], "expected": true}, {"args": [".,;"], "expected": true}], "facts": [["arg", "s", "string"], ["iterate", "s"], ["ask", "palindrome_check"], ["keep", "alnum"], ["map", "lower"]], "deps": {"schema": ["palindrome_check"], "uses": ["sequence_palindrome"], "solution_sha256": "f9bf1014d2802acc716cad50aff857cb2629bee6ae122fc199a85d9ab19d9eef", "reference_sha256": "0b17ca91d1db6d7874380ac8ee9ce4c605c37c423d2e8f52acf3b1a32a83eea4"}}