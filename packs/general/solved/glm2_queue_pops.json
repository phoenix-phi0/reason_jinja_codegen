{"id": "glm2_queue_pops", "signature": "solve(ops)", "statement": "Simulate a FIFO queue. Given a list ops whose elements are either the tuple ('push', x) with integer x, or the tuple ('pop',), return the list of all values returned by the 'pop' operations in order; a pop on an empty queue contributes the value None. The ops list may be empty, in which case return [].", "tests": [{"args": [[]], "expected": []}, {"args": [[["push", 1], ["pop"]]], "expected": [1]}, {"args": [[["pop"]]], "expected": [null]}, {"args": [[["push", 1], ["push", 2], ["pop"], ["pop"], ["pop"]]], "expected": [1, 2, null]}, {"args": [[["pop"], ["push", 5], ["pop"]]], "expected": [null, 5]}, {"args": [[["push", 9]]], "expected": []}, {"args": [[["push", 1], ["pop"], ["push", 2], ["push", 3], ["pop"]]], "expected": [1, 2]}, {"args": [[["pop"], ["pop"]]], "expected": [null, null]}, {"args": [[["push", -1], ["push", -2], ["pop"]]], "expected": [-1]}, {"args": [[["pop"], ["push", 0], ["pop"], ["pop"]]], "expected": [null, 0, null]}, {"args": [[["push", 7], ["pop"], ["pop"]]], "expected": [7, null]}], "facts": [["arg", "ops", "op_list"], ["iterate", "ops"], ["ask", "simulate_ops"], ["container", "queue"], ["sim_output", "results"], ["if_empty", "none"]], "deps": {"schema": ["op_simulation"], "uses": ["container_simulate"], "solution_sha256": "0303ea5e37f1e11a0beed19e5b7e384a5aed79f9b5fc842f050e046ca132e9f3", "reference_sha256": "691f22e3d786b807740d4aa56e06ede26ce87b1f31510a91ba33b003deae1b85"}}