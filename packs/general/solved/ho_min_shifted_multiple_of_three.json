{"id": "ho_min_shifted_multiple_of_three", "signature": "solve(temperatures)", "statement": "Given a list of integers `temperatures`, consider only the entries divisible by 3 (zero counts as divisible by 3, and so do negative entries such as -3 and -9). For each such entry, compute its value plus 10. Return the smallest of these results. If no entry is divisible by 3, including when the list is empty, return None.", "tests": [{"args": [[]], "expected": null}, {"args": [[1, 2, 4]], "expected": null}, {"args": [[3]], "expected": 13}, {"args": [[-3, -6, 9]], "expected": 4}, {"args": [[0]], "expected": 10}, {"args": [[1, 5, 7, -9]], "expected": 1}, {"args": [[12, 30, -12]], "expected": -2}, {"args": [[2, -1, 8]], "expected": null}, {"args": [[100, 99, 98]], "expected": 109}, {"args": [[-3, -3]], "expected": 7}, {"args": [[4, 5, 6, 7]], "expected": 16}], "facts": [["arg", "temperatures", "int_list"], ["iterate", "temperatures"], ["remainder", "3", "0"], ["add", "10"], ["aggregate", "min"], ["if_empty", "none"], ["size", "temperatures", "tiny"]], "deps": {"schema": ["seq_fold"], "uses": [], "solution_sha256": "f5158eb38278a1fedc5dab24c3a53530ea3fc946fa60a4d06ff562cb7db0bc69", "reference_sha256": "7037fcd4bc91e77f9d9f64768b9f2288ffabe1f3449451f6c24c88eff7557611"}}