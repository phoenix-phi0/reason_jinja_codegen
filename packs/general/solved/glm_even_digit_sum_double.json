{"id": "glm_even_digit_sum_double", "signature": "solve(nums)", "statement": "Given a list of integers nums (possibly negative, possibly empty), keep the integers whose decimal digit sum is even (the digit sum of a negative number uses its absolute value), double each kept integer, and return the sum of the doubles. Return 0 for an empty list or if nothing qualifies.", "tests": [{"args": [[]], "expected": 0}, {"args": [[1]], "expected": 0}, {"args": [[2, 4]], "expected": 12}, {"args": [[11, 12, 13]], "expected": 48}, {"args": [[-13, -20]], "expected": -66}, {"args": [[0]], "expected": 0}, {"args": [[100, 101, 7]], "expected": 202}, {"args": [[1234]], "expected": 2468}, {"args": [[99, 98, 97, 96]], "expected": 392}, {"args": [[-2, -3, 5]], "expected": -4}, {"args": [[10, 20, 30, 40]], "expected": 120}], "facts": [["arg", "nums", "int_list"], ["iterate", "nums"], ["digit_sum_test", "2", "0"], ["scale", "2"], ["aggregate", "sum"], ["if_empty", "0"], ["size", "nums", "tiny"]], "deps": {"schema": ["seq_fold"], "uses": ["digit_sums"], "solution_sha256": "01b210372584ee4b9bc5ae4a7a8543f20e71bc4a0af102f4a0cd8cd027ed0bfb", "reference_sha256": "90bea00430dcf89fac079fed8f636a2d1edf7d0bf95aa270be7d7882aec8c7e6"}}