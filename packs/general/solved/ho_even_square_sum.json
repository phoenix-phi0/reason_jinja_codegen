{"id": "ho_even_square_sum", "signature": "solve(numbers)", "statement": "Given a list of integers `numbers`, return the sum of the squares of its even elements. Repeated values count every time they appear. Negative even numbers count (their squares are positive). Return 0 if there are no even elements, including when the list is empty.", "tests": [{"args": [[]], "expected": 0}, {"args": [[1, 3, 5]], "expected": 0}, {"args": [[2]], "expected": 4}, {"args": [[2, 2, 3]], "expected": 8}, {"args": [[-2, 4]], "expected": 20}, {"args": [[0]], "expected": 0}, {"args": [[1, 2, 3, 4, 5, 6]], "expected": 56}, {"args": [[-3, -4]], "expected": 16}, {"args": [[1000000, 1]], "expected": 1000000000000}, {"args": [[7, 8, -8, 9]], "expected": 128}, {"args": [[2, 4, 6, 8, 10]], "expected": 220}, {"args": [[-6, -6, 6]], "expected": 108}], "facts": [["arg", "numbers", "int_list"], ["iterate", "numbers"], ["keep", "even"], ["map", "square"], ["aggregate", "sum"], ["if_empty", "0"], ["size", "numbers", "tiny"]], "deps": {"schema": ["seq_fold"], "uses": [], "solution_sha256": "5268fefcbc9454400162483d7c61ec94789be0bd187d98c35ee1e262b6fa5290", "reference_sha256": "90da9b211f30763ce39ed40a3f2edf34cbea971d018310a751af9f70e77d1766"}}