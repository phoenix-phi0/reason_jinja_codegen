{"id": "knap_ordered_mod", "signature": "solve(parts, length)", "statement": "A rod of the given length is cut into consecutive pieces whose lengths come from parts, positive integers (each part length can be used any number of times). Count the different ordered ways to cut it completely, modulo 1000000007. Length 0 has one way.", "tests": [{"args": [[1, 2, 5], 11], "expected": 218}, {"args": [[2], 3], "expected": 0}, {"args": [[1], 0], "expected": 1}, {"args": [[3, 7], 1], "expected": 0}, {"args": [[2, 3, 5], 8], "expected": 6}, {"args": [[5, 10, 25], 30], "expected": 15}, {"args": [[4, 6], 14], "expected": 3}, {"args": [[1, 3, 4], 6], "expected": 9}, {"args": [[7], 21], "expected": 1}, {"args": [[2, 9], 13], "expected": 3}], "facts": [["arg", "parts", "int_list"], ["arg", "length", "int"], ["items", "parts"], ["target", "length"], ["ask", "count_ways"], ["order", "matters"], ["modulo", "1000000007"], ["size", "parts", "tiny"], ["size", "length", "tiny"], ["guarantees", "parts", "positive"], ["guarantees", "parts", "distinct"]], "deps": {"schema": ["knapsack"], "uses": ["knap_count_ways"], "solution_sha256": "d63f2e27875e9668ed531453b14495d97fb9ad19ae6a22ac678e24942d9680cd", "reference_sha256": "ea96172f60ad1cab73262acdc2f06cc8f17038de31a95841e638f7bb6152c06f"}}