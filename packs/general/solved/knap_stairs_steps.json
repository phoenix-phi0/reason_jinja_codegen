{"id": "knap_stairs_steps", "signature": "solve(n, steps)", "statement": "You climb a staircase of n stairs; each move climbs a number of stairs taken from steps, a list of positive integers (any move may be repeated). Return the number of distinct sequences of moves that reach exactly the top. n = 0 has one (empty) sequence.", "tests": [{"args": [11, [1, 2, 5]], "expected": 218}, {"args": [3, [2]], "expected": 0}, {"args": [0, [1]], "expected": 1}, {"args": [1, [3, 7]], "expected": 0}, {"args": [8, [2, 3, 5]], "expected": 6}, {"args": [30, [5, 10, 25]], "expected": 15}, {"args": [14, [4, 6]], "expected": 3}, {"args": [6, [1, 3, 4]], "expected": 9}, {"args": [21, [7]], "expected": 1}, {"args": [13, [2, 9]], "expected": 3}], "facts": [["arg", "n", "int"], ["arg", "steps", "int_list"], ["items", "steps"], ["target", "n"], ["ask", "count_ways"], ["order", "matters"], ["size", "n", "tiny"], ["size", "steps", "tiny"], ["guarantees", "steps", "positive"], ["guarantees", "steps", "distinct"]], "deps": {"schema": ["knapsack"], "uses": ["knap_count_ways"], "solution_sha256": "1cf6c784ef4a91ba2a7a006f93eb9aa27fb9a831a95ec5e638c8f86221adaaff", "reference_sha256": "355b124026321aa33c58b7cf0356a9d3ac59162e0af451a03abb3f18ed0dd208"}}