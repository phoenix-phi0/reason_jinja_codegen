{"id": "knap_subset_sum", "signature": "solve(nums, target)", "statement": "Can you choose some of the positive integers in nums (each position at most once) so that they add up to exactly target? Return true or false. Choosing nothing gives 0.", "tests": [{"args": [[1, 2, 3], 4], "expected": true}, {"args": [[1, 5, 11, 5], 11], "expected": true}, {"args": [[2, 4, 6], 5], "expected": false}, {"args": [[], 0], "expected": true}, {"args": [[3], 3], "expected": true}, {"args": [[1, 1, 1, 1], 2], "expected": true}, {"args": [[2, 3, 7, 8, 10], 11], "expected": true}, {"args": [[5, 3, 9, 1], 12], "expected": true}, {"args": [[4, 4, 4], 8], "expected": true}, {"args": [[6, 1, 2, 8, 3], 9], "expected": true}], "facts": [["arg", "nums", "int_list"], ["arg", "target", "int"], ["items", "nums"], ["target", "target"], ["ask", "feasible"], ["use", "once"], ["size", "nums", "tiny"], ["size", "target", "tiny"], ["guarantees", "nums", "positive"]], "deps": {"schema": ["knapsack"], "uses": ["knap_feasible"], "solution_sha256": "33ac15817027e4e8e240cb7672bf9fdcfe9ed99dcd04c142476d9886f4d75a03", "reference_sha256": "c9f177618826374ea9ddc3a594692164b32c646b343950bc9cbc4a9e261d1f38"}}