{"id": "glm_bracket_nesting", "signature": "solve(s)", "statement": "Given a string s containing the bracket characters '(', ')', '[', ']', '{', '}' and possibly other characters, return True if all brackets in s are balanced and properly nested, and False otherwise. The empty string is balanced. Other characters are ignored.", "tests": [{"args": [""], "expected": true}, {"args": ["()"], "expected": true}, {"args": ["([{}])"], "expected": true}, {"args": ["(]"], "expected": false}, {"args": ["([)]"], "expected": false}, {"args": ["a(b)c[d]{e}"], "expected": true}, {"args": ["(("], "expected": false}, {"args": ["))"], "expected": false}, {"args": ["{[()]}extra"], "expected": true}, {"args": ["()[]{}"], "expected": true}, {"args": ["no brackets at all"], "expected": true}, {"args": ["{a(b[c]d)e}f"], "expected": true}], "facts": [["arg", "s", "string"], ["iterate", "s"], ["ask", "balanced_brackets"], ["bracket_pair", "(", ")"], ["bracket_pair", "[", "]"], ["bracket_pair", "{", "}"], ["size", "s", "tiny"]], "deps": {"schema": ["bracket_match"], "uses": ["bracket_scan"], "solution_sha256": "b64cde3cc643c1a1226f04da42283787ef269b1cd094360b6bf9e019d81a27ad", "reference_sha256": "5e9671cdb8f4ce23c0e8c0fb01ca47a74f90417e6bf1ca596f4a89434c9d439c"}}