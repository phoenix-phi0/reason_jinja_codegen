{"id": "glm2_transpose", "signature": "solve(mat)", "statement": "Given a matrix mat as a non-empty list of equal-length non-empty lists of integers, return its transpose as a list of lists. The input has at least one row and one column.", "tests": [{"args": [[[1]]], "expected": [[1]]}, {"args": [[[1, 2, 3]]], "expected": [[1], [2], [3]]}, {"args": [[[1, 2], [3, 4]]], "expected": [[1, 3], [2, 4]]}, {"args": [[[1, 2, 3], [4, 5, 6]]], "expected": [[1, 4], [2, 5], [3, 6]]}, {"args": [[[1, 2], [3, 4], [5, 6]]], "expected": [[1, 3, 5], [2, 4, 6]]}, {"args": [[[7, 8], [9, 10], [11, 12]]], "expected": [[7, 9, 11], [8, 10, 12]]}, {"args": [[[0, 0], [0, 0]]], "expected": [[0, 0], [0, 0]]}, {"args": [[[-1]]], "expected": [[-1]]}, {"args": [[[5, 6], [7, 8], [9, 10]]], "expected": [[5, 7, 9], [6, 8, 10]]}, {"args": [[[42]]], "expected": [[42]]}, {"args": [[[1, 2], [3, 4]]], "expected": [[1, 3], [2, 4]]}], "facts": [["arg", "mat", "int_matrix"], ["iterate", "mat"], ["ask", "matrix_transform"], ["matrix_op", "transpose"], ["size", "mat", "tiny"]], "deps": {"schema": ["matrix_transform"], "uses": ["matrix_reorient"], "solution_sha256": "e34043007fd84154587bf9f1fe20533aaaea59b30473a74c3db5fe03d0917e7b", "reference_sha256": "f8aa35afec2f10152b3949a5a8d53294f2410a387a5a3c31f0ff3186916308fd"}}