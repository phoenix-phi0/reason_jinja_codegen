{"id": "grid_regions_8", "signature": "solve(picture)", "statement": "picture is a list of equal-length strings of '#' and '.'. Count the shapes made of '#' cells, where cells touching horizontally, vertically or diagonally belong to the same shape.", "tests": [{"args": [[]], "expected": 0}, {"args": [["#"]], "expected": 1}, {"args": [["."]], "expected": 0}, {"args": [["#.#", ".#.", "#.#"]], "expected": 1}, {"args": [["##..", "#...", "...#", "..##"]], "expected": 2}, {"args": [["#..", "..#", "###", "#..", "#.#", "###", "###", ".##", "###"]], "expected": 2}, {"args": [["#.#.....#..", "..#....#...", "..#.##.##..", "#..#...#...", "..#..######"]], "expected": 4}, {"args": [["......", "..#..#", ".#.#..", "#.#..#", "#..#.#", "####.#"]], "expected": 3}, {"args": [["#..#.#..", "#.......", "#..##.##", "..#.#...", "..##...#", "#.....##", "...####."]], "expected": 7}, {"args": [[".##..", ".#.##", "..##."]], "expected": 1}, {"args": [["#.###", "..#..", "#...#", ".#...", ".##..", "...#.", "#.#.#", "#...#", "...#.", "..#.#", "....#"]], "expected": 5}], "facts": [["arg", "picture", "grid"], ["passable", "#"], ["connect", "8"], ["ask", "count_components"], ["size", "picture", "tiny"]], "deps": {"schema": ["grid_components"], "uses": ["grid_component_sizes"], "solution_sha256": "3e7ed939799d1c1c4eddd097948421332d60cd6a839cecc920b8ce107204b337", "reference_sha256": "86b8fc283b26b7c24d48eb7a81e9e787c440ca5bed4d0714bb6b657d28589e37"}}