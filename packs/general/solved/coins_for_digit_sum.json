{"id": "coins_for_digit_sum", "signature": "coins_for_digit_sum(coins, n)", "statement": "coins is a list of positive integers (unlimited supply of each), n >= 0. Let s be the sum of the decimal digits of n. Return the minimum number of coins that add up to exactly s, or -1 if that is impossible.", "tests": [{"args": [[1], 0], "expected": 0}, {"args": [[2], 7], "expected": -1}, {"args": [[5, 2], 129], "expected": 3}, {"args": [[1, 3, 4], 99], "expected": 5}, {"args": [[7], 25], "expected": 1}, {"args": [[4, 6], 11], "expected": -1}, {"args": [[3, 5], 6789], "expected": 6}, {"args": [[10, 1], 999], "expected": 9}, {"args": [[2, 3], 1000000], "expected": -1}, {"args": [[9, 8], 55], "expected": -1}], "facts": [["arg", "coins", "int_list"], ["arg", "n", "int"], ["guarantees", "coins", "positive"], ["stage", "1", "seq_fold"], ["stage", "2", "knapsack"], ["1.source", "digits", "n"], ["1.aggregate", "sum"], ["2.items", "coins"], ["2.target", "stage1"], ["2.ask", "min_count"]], "deps": {"schema": ["knapsack", "seq_fold", "staged"], "uses": ["knap_min_count"], "solution_sha256": "90002ebe3d2da4c58eb5891228b2c1269198ed140245953ddbeeda9628a44f31", "reference_sha256": "5548785bc0f487d9b1dce05ec16e490dc5a0217e40831000e46d71ea0d3824cf"}}