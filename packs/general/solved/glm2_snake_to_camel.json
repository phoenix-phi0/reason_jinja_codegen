{"id": "glm2_snake_to_camel", "signature": "solve(s)", "statement": "Given a lowercase snake_case string s (lowercase letters and underscores, no leading, trailing or consecutive underscores, possibly empty), convert it to lowerCamelCase: the first word stays all lowercase and every later word has its first letter uppercased. The empty string returns the empty string.", "tests": [{"args": [""], "expected": ""}, {"args": ["hello"], "expected": "hello"}, {"args": ["hello_world"], "expected": "helloWorld"}, {"args": ["already_camel_case"], "expected": "alreadyCamelCase"}, {"args": ["a_b_c"], "expected": "aBC"}, {"args": ["x"], "expected": "x"}, {"args": ["snake_case_string"], "expected": "snakeCaseString"}, {"args": ["end_"], "expected": "end"}, {"args": ["multi_part_word"], "expected": "multiPartWord"}, {"args": ["q_r"], "expected": "qR"}, {"args": ["one"], "expected": "one"}, {"args": ["a_b"], "expected": "aB"}], "facts": [["arg", "s", "string"], ["iterate", "s"], ["ask", "convert_case"], ["case_from", "snake"], ["case_to", "camel"]], "deps": {"schema": ["case_convert"], "uses": ["case_convert"], "solution_sha256": "93f7ce459fecc5ff323aeaadbc8ee9231fcc7651f515d173c61f09f2c0ee05da", "reference_sha256": "32625fa76f1f9f31c1d8912de62442f4c1623ef66a6892e75cd102ee77d59761"}}