{"id": "glm_divisible_sum_pairs", "signature": "solve(nums, m)", "statement": "Given a list of integers nums (possibly negative, possibly empty) and a positive integer m, return the number of pairs of positions i < j such that nums[i] + nums[j] is divisible by m. Note that in Python the remainder of a negative number still lies in [0, m).", "tests": [{"args": [[], 3], "expected": 0}, {"args": [[1, 2], 3], "expected": 1}, {"args": [[1, 2, 3], 3], "expected": 1}, {"args": [[1, 2, 3, 4], 2], "expected": 2}, {"args": [[5, 5, 5], 5], "expected": 3}, {"args": [[-1, 1], 5], "expected": 1}, {"args": [[-1, -2, -3], 3], "expected": 1}, {"args": [[0, 0, 0], 7], "expected": 3}, {"args": [[1, 3, 2, 6, 1, 2], 3], "expected": 5}, {"args": [[4, 5, 6, 7], 10], "expected": 1}, {"args": [[9], 4], "expected": 0}], "facts": [["arg", "nums", "int_list"], ["arg", "m", "int"], ["iterate", "nums"], ["ask", "count_pairs"], ["pair_test", "sum", "m", "0"], ["size", "nums", "tiny"], ["size", "m", "tiny"]], "deps": {"schema": ["pair_count"], "uses": ["count_pairs_residue"], "solution_sha256": "1d9532fdfb2c57b4991c1c48f8061cdea4b301639a0dc3cd29477348c6ca7dbe", "reference_sha256": "2657872bcfa03020db28c2525dee1bff8d1ec3e821e62fdbfada0c42dd1bc757"}}