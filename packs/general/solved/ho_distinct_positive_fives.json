{"id": "ho_distinct_positive_fives", "signature": "solve(readings)", "statement": "Given a list of integers `readings`, count how many DISTINCT values in it are strictly positive multiples of 5. Repeated values are counted once. Zero is not counted (it is not strictly positive) and negative multiples of 5 are not counted. Return 0 if there are none, including for an empty list.", "tests": [{"args": [[]], "expected": 0}, {"args": [[5, 10, 15]], "expected": 3}, {"args": [[5, 5, 5]], "expected": 1}, {"args": [[-5, 0, 5]], "expected": 1}, {"args": [[10, -10, 20, 20, 30]], "expected": 3}, {"args": [[1, 2, 3]], "expected": 0}, {"args": [[25, 50, 75, 100]], "expected": 4}, {"args": [[0]], "expected": 0}, {"args": [[-15]], "expected": 0}, {"args": [[5, 10, 15, 20, 25, 5, 10]], "expected": 5}, {"args": [[7, 14, 35]], "expected": 1}, {"args": [[500, 500, -500, 5]], "expected": 2}], "facts": [["arg", "readings", "int_list"], ["iterate", "readings"], ["keep", "positive"], ["remainder", "5", "0"], ["aggregate", "distinct_count"], ["size", "readings", "tiny"]], "deps": {"schema": ["seq_fold"], "uses": [], "solution_sha256": "0e42114c546afd58364abbed02bee34fcf7b210ff52a4c99b9f43db46d478457", "reference_sha256": "f895a8499b9a30315457337feb400db1315e437cfd13e8ad3f78cdf1b55d8194"}}