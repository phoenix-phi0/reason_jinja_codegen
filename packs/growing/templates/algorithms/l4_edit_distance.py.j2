def solve(a, b):
    # Strip common prefix and suffix
    n, m = len(a), len(b)
    s = 0
    while s < n and s < m and a[s] == b[s]:
        s += 1
    a = a[s:]
    b = b[s:]
    n -= s
    m -= s
    while n > 0 and m > 0 and a[n - 1] == b[m - 1]:
        n -= 1
        m -= 1
    a = a[:n]
    b = b[:m]

    if n == 0:
        return m
    if m == 0:
        return n

    # Ensure b is the shorter for row storage
    if m > n:
        a, b = b, a
        n, m = m, n

    prev = list(range(m + 1))
    for i in range(1, n + 1):
        ca = a[i - 1]
        cur = [i] + [0] * m
        left = i
        for j in range(1, m + 1):
            cost = prev[j - 1] if b[j - 1] == ca else prev[j - 1] + 1
            up = prev[j] + 1
            l = left + 1
            if up < cost:
                cost = up
            if l < cost:
                cost = l
            cur[j] = cost
            left = cost
        prev = cur
    return prev[m]
