def solve(s):
    if not s:
        return ""
    out = []
    prev = s[0]
    count = 1
    for i in range(1, len(s)):
        c = s[i]
        if c == prev:
            count += 1
        else:
            out.append(str(count))
            out.append(prev)
            prev = c
            count = 1
    out.append(str(count))
    out.append(prev)
    return "".join(out)
{% endraw %}
