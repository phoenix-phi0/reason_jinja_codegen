def solve(s):
    def ok(c):
        return ('a' <= c <= 'z') or ('A' <= c <= 'Z') or ('0' <= c <= '9')

    i, j = 0, len(s) - 1
    while i < j:
        while i < j and not ok(s[i]):
            i += 1
        while i < j and not ok(s[j]):
            j -= 1
        if i < j:
            if s[i].lower() != s[j].lower():
                return False
            i += 1
            j -= 1
    return True
