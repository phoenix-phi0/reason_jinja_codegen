from collections import OrderedDict


def solve(capacity, ops):
    cache = OrderedDict()
    results = []
    for op in ops:
        if op[0] == 'get':
            key = op[1]
            if key in cache:
                cache.move_to_end(key)
                results.append(cache[key])
            else:
                results.append(-1)
        else:
            key, value = op[1], op[2]
            if key in cache:
                cache.move_to_end(key)
            cache[key] = value
            if len(cache) > capacity:
                cache.popitem(last=False)
    return results
