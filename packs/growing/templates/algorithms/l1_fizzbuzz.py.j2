{% raw %}
def solve(n):
    result = []
    append = result.append
    for i in range(1, n + 1):
        if i % 15 == 0:
            append("FizzBuzz")
        elif i % 3 == 0:
            append("Fizz")
        elif i % 5 == 0:
            append("Buzz")
        else:
            append(str(i))
    return result
{% endraw %}
