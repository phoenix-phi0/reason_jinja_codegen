def solve(height):
    if not height:
        return 0
    l, r = 0, len(height) - 1
    lmax = rmax = 0
    total = 0
    while l <= r:
        if lmax <= rmax:
            h = height[l]
            if h > lmax:
                lmax = h
            else:
                total += lmax - h
            l += 1
        else:
            h = height[r]
            if h > rmax:
                rmax = h
            else:
                total += rmax - h
            r -= 1
    return total
