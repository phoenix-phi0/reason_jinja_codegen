def solve(a, b):
    n, m = len(a), len(b)
    res = [0] * (n + m)
    i = j = k = 0
    while i < n and j < m:
        if a[i] <= b[j]:
            res[k] = a[i]
            i += 1
        else:
            res[k] = b[j]
            j += 1
        k += 1
    while i < n:
        res[k] = a[i]
        i += 1
        k += 1
    while j < m:
        res[k] = b[j]
        j += 1
        k += 1
    return res
