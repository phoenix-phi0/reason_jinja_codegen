def solve(grid):
    if not grid:
        return 0
    rows = len(grid)
    cols = len(grid[0]) if rows else 0
    if cols == 0:
        return 0
    visited = [bytearray(len(row)) for row in grid]
    count = 0
    for r in range(rows):
        row = grid[r]
        for c in range(len(row)):
            if row[c] == '1' and not visited[r][c]:
                count += 1
                visited[r][c] = 1
                stack = [(r, c)]
                while stack:
                    x, y = stack.pop()
                    if x > 0 and y < len(grid[x - 1]) and grid[x - 1][y] == '1' and not visited[x - 1][y]:
                        visited[x - 1][y] = 1
                        stack.append((x - 1, y))
                    if x + 1 < rows and y < len(grid[x + 1]) and grid[x + 1][y] == '1' and not visited[x + 1][y]:
                        visited[x + 1][y] = 1
                        stack.append((x + 1, y))
                    if y > 0 and grid[x][y - 1] == '1' and not visited[x][y - 1]:
                        visited[x][y - 1] = 1
                        stack.append((x, y - 1))
                    if y + 1 < len(grid[x]) and grid[x][y + 1] == '1' and not visited[x][y + 1]:
                        visited[x][y + 1] = 1
                        stack.append((x, y + 1))
    return count
