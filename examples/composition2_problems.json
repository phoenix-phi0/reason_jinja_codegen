 {
  "id": "longest_letter_run",
  "signature": "longest_letter_run(s)",
  "statement": "Ignore every character of s that is not a letter and ignore case. In the remaining sequence of letters, return the length of the longest run of equal adjacent letters (0 if there are no letters).",
  "tests": [
   {
    "args": [
     ""
    ],
    "expected": 0
   },
   {
    "args": [
     "a"
    ],
    "expected": 1
   },
   {
    "args": [
     "aab"
    ],
    "expected": 2
   },
   {
    "args": [
     "a1a"
    ],
    "expected": 2
   },
   {
    "args": [
     "AaBb"
    ],
    "expected": 2
   },
   {
    "args": [
     "ab ba"
    ],
    "expected": 2
   },
   {
    "args": [
     "Mississippi"
    ],
    "expected": 2
   },
   {
    "args": [
     "x-x-x y"
    ],
    "expected": 3
   },
   {
    "args": [
     "123"
    ],
    "expected": 0
   },
   {
    "args": [
     "hello  wOrld!!"
    ],
    "expected": 2
   },
   {
    "args": [
     "aaa b aaaa"
    ],
    "expected": 4
   },
   {
    "args": [
     "zz9Zz"
    ],
    "expected": 4
   }
  ]
 },
